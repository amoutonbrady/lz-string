{
  "name": "@amoutonbrady/lz-string",
  "version": "0.2.0",
  "description": "Modern TypeScript port of lz-string: LZ-based compression for JavaScript strings",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Alexandre Mouton-Brady",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amoutonbrady/lz-string.git"
  },
  "homepage": "https://github.com/amoutonbrady/lz-string#readme",
  "bugs": "https://github.com/amoutonbrady/lz-string/issues",
  "keywords": [
    "lz-string",
    "lz",
    "compression",
    "compress",
    "decompress",
    "base64",
    "utf16",
    "uint8array",
    "typescript"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.3.4",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm check"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^26.4.1",
    "lz-string": "^1.5.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  }
}
